# Environment configuration for AAta Chusthava

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aata_chusthava"

# Redis Cache & Queue (optional, falls back to in-memory provider)
REDIS_URL="redis://localhost:6379"

# External Data Source (TMDB)
TMDB_API_KEY="your_tmdb_api_key"
TMDB_API_READ_ACCESS_TOKEN="your_tmdb_access_token"

# Security & Secrets
# Required in production. Used to authenticate admin API endpoints.
ADMIN_API_SECRET="your_admin_secret_key"
# Required in production. Server-side cryptographic secret for deterministic Daily Puzzle PRNG seed/jitter.
# Never expose client-side or commit real production values. Rotate through deployment secrets management.
DAILY_PUZZLE_SECRET="your_secure_server_side_daily_puzzle_secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="production"

